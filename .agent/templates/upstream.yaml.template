# Workflow Upstream Provenance 模板
#
# 该文件不是由安装包直接复制到宿主；它只在一次成功的 install / upgrade
# 事务末尾由 `.agent/adoption/workflow-adoption` 生成或更新。
#
# 职责边界：
# - `.agent/VERSION`：框架内容版本（source distribution 自带）。
# - `.agent/upstream.yaml`：本宿主实际安装来源、精确 Commit、分发包校验、
#   B 快照位置与最近一次成功升级记录。它是安装来源的唯一权威。
# - 不新增 `.agent/engine.version`：Engine 版本由本文件的 Commit / 分发包
#   校验与 `.agent/VERSION` 共同确定，避免两个文件对版本给出冲突结论。
schema_version: 1

source:
  repository: <UPSTREAM_REPOSITORY>
  kind: source-archive | source-tree
  name: <DISTRIBUTION_NAME>
  sha256: <DISTRIBUTION_OR_CONTENT_SHA256>
  framework_version: <VERSION_FROM_.agent/VERSION>
  commit: <FULL_40_HEX_COMMIT>
  release: ""            # 正式 GA Tag 由 P08 创建；未发布时必须为空

installed:
  action: install | upgrade
  at: <UTC_TIMESTAMP>
  owner: <OWNER>
  branch: <HOST_BRANCH_AT_INSTALL>
  integration_branch: <OWNER_CONFIRMED_BRANCH>
  previous_commit: ""    # upgrade 时为上次安装 Commit

snapshot:
  store: "git-dir:workflow-adoption"
  ref: "snapshots/<FULL_40_HEX_COMMIT>"
  manifest_sha256: <SNAPSHOT_MANIFEST_SHA256>
  file_count: <N>

runtime:
  workflow_check: ".agent/bin/workflow-check"
  workflow_check_sha256: <BINARY_SHA256>
  provenance: local-build | external-verified | preserved

compatibility:
  config_schema: 1
  state_schema: "2,3"

last_upgrade:            # 仅在上次成功 upgrade 后出现
  from_commit: <FULL_40_HEX_COMMIT>
  to_commit: <FULL_40_HEX_COMMIT>
  at: <UTC_TIMESTAMP>
  distribution_sha256: <SHA256>
