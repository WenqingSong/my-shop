# =============================================================================
# my-shop 环境变量示例模板（Docker Compose 变量替换 + 敏感凭据注入）
#
# 用法：cp .env.example .env  然后按需填写本地真实值（.env 已被 .gitignore 忽略）。
#
# 加载方式：docker compose 会自动读取项目根目录的 .env 做 ${VAR} 替换，
# 再由 app 服务的 environment 注入到容器（环境变量 > manifest/config/config.yaml 默认值）。
#
# 安全边界：本文件仅保存变量名与安全默认值，绝不保存真实凭据，可提交 Git；
#           真实 Secret 一律留空（MYSQL_ROOT_PASSWORD / AUTH_JWT_SECRET /
#           ADMIN_SUPER_PASSWORD / QINIU_SECRET_KEY 等），由开发者在本地 .env 填写，
#           绝不提交仓库、不进镜像、不进日志/响应。
# =============================================================================

# ---- 服务端口（宿主机映射端口，可覆盖）----
# Nginx 对外唯一 HTTP 入口端口（app 不再映射宿主机端口）。
NGINX_PORT=8080
APP_PORT=8000
MYSQL_PORT=3306
REDIS_PORT=6379
PROMETHEUS_PORT=9090

# ---- MySQL（mysql 服务初始化与 app 连接共用同一 root 凭据）----
# root 密码：敏感凭据，必填（无内置默认回退）。留空时 docker-compose.yml 因 ${MYSQL_ROOT_PASSWORD:?}
# 直接失败，MySQL 无法启动；请填写真实密码（本地开发也需显式提供，不再回退 dev 默认值）。
MYSQL_ROOT_PASSWORD=
# 业务数据库名（mysql 服务启动时创建，app 通过它连接）。
MYSQL_DATABASE=my_shop

# ---- 认证（JWT）----
# JWT 签名密钥（HS256，≥32 字节）。敏感凭据，必填（无内置默认回退）。留空时 docker-compose.yml
# 因 ${AUTH_JWT_SECRET:?} 直接失败；生产须替换为随机密钥并经平台 Secret 注入。
AUTH_JWT_SECRET=

# ---- 后台超级管理员 ----
ADMIN_SUPER_USERNAME=admin
# 超级管理员初始密码（仅「数据库尚无超管、首次创建」时需要）。
# 无默认值：留空且需首次建号时 serve 启动 fail-fast。
ADMIN_SUPER_PASSWORD=

# ---- 七牛云对象存储（以下 4 项为 serve 启动 required dependency，需填入真实值）----
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=
# 七牛区域（z0/z1/z2/na0/as0）
QINIU_REGION=z2
# 上传凭证有效期（秒，必须大于 0）
QINIU_TOKEN_TTL=3600
# 单文件大小上限（字节，必须大于 0）
QINIU_MAX_FILE_SIZE=10485760

# ---- 秒杀指标开关（Prometheus /metrics 暴露开关）----
FLASH_SALE_METRICS_ENABLED=false

# ---- 启动依赖校验超时（秒）----
STARTUP_DEPENDENCY_TIMEOUT=30
