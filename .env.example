# =============================================================================
# my-shop 环境变量示例模板（完整配置清单，与 manifest/config/config.yaml 一一对应）
#
# 用法：cp .env.example .env  然后按需填写本地真实值（.env 已被 .gitignore 忽略）。
#
# 加载优先级（scripts/lib.sh）：
#   已导出的环境变量  >  .env 中的非空值  >  config.yaml 默认值
#   说明：.env 中 `KEY=`（空值）不会被导出，因此不会覆盖 config.yaml 的非空默认值；
#   只有填入非空值才会覆盖。请勿在 .env 里用空值覆盖本应保留的默认配置。
#
# 环境变量命名规则：配置键中的 `.` 替换为 `_` 并转为大写。
# 例如 database.default.host → DATABASE_DEFAULT_HOST。
#
# 安全边界：本文件仅保存变量名与安全默认值，绝不保存真实凭据，可提交 Git；
#           真实 Secret 一律留空（AUTH_JWT_SECRET / ADMIN_SUPER_PASSWORD / QINIU_SECRET_KEY 等），
#           由开发者在本地 .env 填写，绝不提交仓库、不进日志/响应。
# =============================================================================

# ---- 服务 ----
SERVER_ADDRESS=:8000

# ---- MySQL（开发默认值；生产/自定义环境请覆盖真实值）----
DATABASE_DEFAULT_TYPE=mysql
DATABASE_DEFAULT_HOST=127.0.0.1
DATABASE_DEFAULT_PORT=3306
DATABASE_DEFAULT_USER=root
DATABASE_DEFAULT_PASS=root
DATABASE_DEFAULT_NAME=my_shop
DATABASE_DEFAULT_CHARSET=utf8
DATABASE_DEFAULT_DEBUG=false

# ---- Redis ----
REDIS_DEFAULT_ADDRESS=127.0.0.1:6379
REDIS_DEFAULT_DB=0
REDIS_DEFAULT_PASS=

# ---- 认证（JWT）----
# JWT 签名密钥（HS256），开发默认值为 config.yaml 中的非空默认值；留空回退该默认值。
# 生产必须替换为随机 >= 32 字节的密钥。
AUTH_JWT_SECRET=
# 会话 TTL（秒），必须大于 0。
AUTH_SESSION_TTL=3600
# refresh token 绝对有效期（秒），必须大于 0。
AUTH_REFRESH_TTL=2592000

# ---- 后台超级管理员 ----
ADMIN_SUPER_USERNAME=admin
# 超级管理员初始密码（仅「数据库尚无超管、首次创建」时需要）。
# 无开发默认值：留空回退 config.yaml 默认（空），首次创建时若仍为空将启动失败并提示。
ADMIN_SUPER_PASSWORD=

# ---- 订单 ----
ORDER_PAY_TIMEOUT=900
ORDER_CANCEL_SCAN_INTERVAL=60

# ---- 秒杀 ----
FLASH_SALE_RECONCILE_SCAN_INTERVAL=60

# ---- 本地存储 ----
STORAGE_LOCAL_ROOT=./storage

# ---- 七牛云对象存储（以下 4 项为启动 required dependency，需填入真实值）----
# 七牛 AccessKey（凭据标识，非机密，与 SecretKey 成对注入）
QINIU_ACCESS_KEY=
# 七牛 SecretKey（机密，绝不出现在任何受跟踪文件中）
QINIU_SECRET_KEY=
# 对象存储空间名（非敏感）
QINIU_BUCKET=
# 对外访问域名（非敏感，拼接 final_url = domain/key）
QINIU_DOMAIN=
# 七牛区域（z0/z1/z2/na0/as0）
QINIU_REGION=z2
# 上传凭证有效期（秒，必须大于 0）
QINIU_TOKEN_TTL=3600
# 单文件大小上限（字节，必须大于 0）
QINIU_MAX_FILE_SIZE=10485760
# 后端扩展名预校验白名单（JSON 数组格式；留空则回退 config.yaml 默认值）
QINIU_ALLOWED_EXTENSIONS=["jpg","jpeg","png","gif","webp"]
# 固化进 token mimeLimit 的 MIME 白名单（JSON 数组格式；留空则回退 config.yaml 默认值）
QINIU_ALLOWED_MIME_TYPES=["image/jpeg","image/png","image/gif","image/webp"]

# ---- 启动依赖校验超时（秒）----
STARTUP_DEPENDENCY_TIMEOUT=30
