# =============================================================================
# my-shop 环境变量示例模板（Docker Compose 变量替换 + 敏感凭据注入）
#
# 用法：cp .env.example .env  然后按需填写本地真实值（.env 已被 .gitignore 忽略）。
#
# 加载方式：docker compose 会自动读取项目根目录的 .env 做 ${VAR} 替换，
# 再由 app 服务的 environment 注入到容器（环境变量 > manifest/config/config.yaml 默认值）。
#
# 安全边界：本文件仅保存变量名与安全默认值，绝不保存真实凭据，可提交 Git；
#           真实 Secret 一律留空（MYSQL_ROOT_PASSWORD / AUTH_JWT_SECRET /
#           ADMIN_SUPER_PASSWORD / QINIU_SECRET_KEY 等），由开发者在本地 .env 填写，
#           绝不提交仓库、不进镜像、不进日志/响应。
# =============================================================================

# ---- 服务端口（宿主机映射端口，可覆盖）----
# Nginx 对外唯一 HTTP 入口端口（app 不再映射宿主机端口，无 APP_PORT）。
NGINX_PORT=8080
MYSQL_PORT=3306
REDIS_PORT=6379
PROMETHEUS_PORT=9090

# ---- MySQL（mysql 服务初始化与 app 连接共用同一 root 凭据）----
# root 密码：敏感凭据，必填（无内置默认回退）。留空时 docker-compose.yml 因 ${MYSQL_ROOT_PASSWORD:?}
# 直接失败，MySQL 无法启动；请填写真实密码（本地开发也需显式提供，不再回退 dev 默认值）。
MYSQL_ROOT_PASSWORD=
# 业务数据库名（mysql 服务启动时创建，app 通过它连接）。
MYSQL_DATABASE=my_shop
# 应用账号口令（T2-07 本地 Kubernetes 基础设施使用）：
#   - 由 scripts/k8s-infra.sh secrets 写入 Secret/surgecart-db-credentials 的 DATABASE_DEFAULT_PASS；
#   - MySQL 初始化时用同一个值创建应用账号（与 ConfigMap 的 DATABASE_DEFAULT_USER 对应）；
#   - docker-compose 使用 root 账号，故该键在 Compose 流程中不生效，但 Kubernetes 流程必填。
#   - 与 MYSQL_ROOT_PASSWORD 相同也可以运行，但等于让应用使用管理员口令，不建议。
DATABASE_DEFAULT_PASS=

# ---- 认证（JWT）----
# JWT 签名密钥（HS256，≥32 字节）。敏感凭据，必填（无内置默认回退）。留空时 docker-compose.yml
# 因 ${AUTH_JWT_SECRET:?} 直接失败；生产须替换为随机密钥并经平台 Secret 注入。
AUTH_JWT_SECRET=

# ---- 后台超级管理员 ----
ADMIN_SUPER_USERNAME=admin
# 超级管理员初始密码（仅「数据库尚无超管、首次创建」时需要）。
# 无默认值：留空且需首次建号时 serve 启动 fail-fast。
ADMIN_SUPER_PASSWORD=

# ---- 七牛云对象存储（以下 4 项为 serve 启动 required dependency，需填入真实值）----
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=
# 七牛区域（z0/z1/z2/na0/as0）
QINIU_REGION=z2
# 上传凭证有效期（秒，必须大于 0）
QINIU_TOKEN_TTL=3600
# 单文件大小上限（字节，必须大于 0）
QINIU_MAX_FILE_SIZE=10485760

# ---- 秒杀指标开关（Prometheus /metrics 暴露开关）----
FLASH_SALE_METRICS_ENABLED=false

# ---- 秒杀消费模式（db_scanner | kafka，两种模式互斥；切换需重启）----
# 默认 db_scanner：只运行 MySQL 扫描器，不需要 Kafka。
FLASH_SALE_DISPATCH_MODE=db_scanner
# 仅 kafka 模式需要启用；db_scanner 模式下必须保持 false（否则启动 fail-fast）。
FLASH_SALE_KAFKA_ENABLED=false
FLASH_SALE_KAFKA_BROKERS=127.0.0.1:29092
FLASH_SALE_KAFKA_TOPIC=surgecart.flashsale.order.requested.v1
FLASH_SALE_KAFKA_DLQ_TOPIC=surgecart.flashsale.order.requested.v1.dlq
FLASH_SALE_KAFKA_CONSUMER_GROUP=surgecart-flashsale-order-worker-v1
# Outbox 后台发布循环（Go duration；error_backoff 指数增长、30s 封顶）
FLASH_SALE_KAFKA_PUBLISHER_BATCH_SIZE=100
FLASH_SALE_KAFKA_PUBLISHER_POLL_INTERVAL=200ms
FLASH_SALE_KAFKA_PUBLISHER_ERROR_BACKOFF=2s
# 秒杀后台组件统一关闭预算（Go duration）
FLASH_SALE_SHUTDOWN_TIMEOUT=30s

# ---- 启动依赖校验超时（秒）----
STARTUP_DEPENDENCY_TIMEOUT=30

# ---- 部署严格配置模式（T2-01）----
# false（默认）：本地开发可直接使用 manifest/config/config.yaml 中的 127.0.0.1 默认值。
# true：启动时（建立任何 DB/Redis 连接之前）要求 DATABASE_DEFAULT_HOST、
#       DATABASE_DEFAULT_NAME、REDIS_DEFAULT_ADDRESS 必须由环境变量显式提供，
#       且不得指向 localhost / 127.0.0.1 / ::1 等回环地址；任一不满足即启动失败。
# 后续 T2-06 的 Kubernetes ConfigMap 必须设置为 true。
DEPLOYMENT_REQUIRE_EXTERNAL_ENDPOINTS=false
