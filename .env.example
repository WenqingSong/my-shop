# =============================================================================
# my-shop 环境变量示例模板
#
# 用法：cp .env.example .env  然后填写本地真实值（.env 已被 .gitignore 忽略）。
# 说明：
#   - 本文件仅保存变量名与安全示例/占位，绝不保存真实凭据，可提交 Git。
#   - 环境变量命名规则：配置键中的 `.` 替换为 `_` 并转为大写。
#   - 优先级：已导出的环境变量 > .env > config.yaml 默认值。
#   - 本地通过 `make up` / `scripts/*.sh` 自动加载 .env（scripts/lib.sh）。
# =============================================================================

# ---- 服务 ----
# SERVER_ADDRESS=:8000

# ---- MySQL（开发默认值，生产必须覆盖真实密码）----
# DATABASE_DEFAULT_TYPE=mysql
# DATABASE_DEFAULT_HOST=127.0.0.1
# DATABASE_DEFAULT_PORT=3306
# DATABASE_DEFAULT_USER=root
# DATABASE_DEFAULT_PASS=root
# DATABASE_DEFAULT_NAME=my_shop

# ---- Redis ----
# REDIS_DEFAULT_ADDRESS=127.0.0.1:6379
# REDIS_DEFAULT_DB=0
# REDIS_DEFAULT_PASS=

# ---- 认证（JWT）----
# JWT 签名密钥（HS256），生产必须替换为随机 >= 32 字节的密钥
# AUTH_JWT_SECRET=

# ---- 后台超级管理员初始密码（仅「超管不存在时创建」需要）----
# ADMIN_SUPER_USERNAME=admin
# ADMIN_SUPER_PASSWORD=

# ---- 启动依赖校验超时（秒）----
# STARTUP_DEPENDENCY_TIMEOUT=30

# ---- 七牛云对象存储 ----
# 以下四项为 serve 启动 required dependency，缺失会启动 fail-fast；请填入真实值。
# AK/SK 为机密，仅存本地 .env，绝不提交仓库、不进日志/响应。
# 七牛 AccessKey（凭据标识，非机密，与 SecretKey 成对注入）
QINIU_ACCESS_KEY=
# 七牛 SecretKey（机密，绝不出现在任何受跟踪文件中）
QINIU_SECRET_KEY=
# 对象存储空间名（非敏感，也可写在 config.yaml 的 qiniu.bucket）
QINIU_BUCKET=
# 对外访问域名（非敏感，也可写在 config.yaml 的 qiniu.domain）
QINIU_DOMAIN=
# 七牛区域（z0/z1/z2/na0/as0，可选，默认 z2）
# QINIU_REGION=z2
# 上传凭证有效期（秒，可选，默认 3600）
# QINIU_TOKEN_TTL=3600
# 单文件大小上限（字节，可选，默认 10485760）
# QINIU_MAX_FILE_SIZE=10485760
