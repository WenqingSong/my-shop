# 开发环境配置
VITE_PORT = 8848

# 开发环境访问路径（与生产部署路径保持一致，便于验证子路径部署）
VITE_PUBLIC_PATH = /console/

# 路由历史模式（hash | h5[ ,base ]）：使用 HTML5 history + base，刷新不出现 404
VITE_ROUTER_HISTORY = "h5,/console/"

# 请求基础地址：走 Vite Proxy 转发，不写死后端地址
VITE_API_BASE_URL = /api

# Vite Proxy 转发目标：Go 后端真实监听地址
# 后端默认监听 :8000（见 manifest/config/config.yaml 的 server.address，可用 SERVER_ADDRESS 覆盖）
# 如需修改，请在本文件或 .env.development.local（已被 git 忽略）中调整
VITE_PROXY_TARGET = http://127.0.0.1:8000

# 是否启用 MSW Mock
VITE_MOCK_ENABLED = false
