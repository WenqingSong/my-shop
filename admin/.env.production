# 生产环境配置
# 部署基础路径：管理后台统一挂载在 /console/
VITE_PUBLIC_PATH = /console/

# 路由历史模式：HTML5 history + base
VITE_ROUTER_HISTORY = "h5,/console/"

# 请求基础地址：由网关/Nginx 将 /console/api 或 /api 转发到后端，见 README「部署约定」
VITE_API_BASE_URL = /api

# 生产构建不转发任何代理（proxy 仅在 dev/preview 生效）
# Vite Proxy 目标占位，生产下不生效
VITE_PROXY_TARGET = http://127.0.0.1:8000

# 生产环境禁止启用 Mock
VITE_MOCK_ENABLED = false

# 是否在打包时使用cdn替换本地库 替换 true 不替换 false
VITE_CDN = false

# 是否启用gzip压缩或brotli压缩（gzip、brotli、both、none、gzip-clear、brotli-clear、both-clear）
VITE_COMPRESSION = "none"
