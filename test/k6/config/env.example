# SurgeCart k6 测试环境变量模板（T5-01）
#
# 用法：
#   1. 复制本文件为 test/k6/config/env.local（已被 .gitignore 排除）；
#   2. 填好必需项后，在 PowerShell 中把变量导入当前会话，再执行 scripts/run.ps1：
#        Get-Content test/k6/config/env.local | Where-Object { $_ -match '^\s*[A-Z_]+=' } |
#          ForEach-Object { $kv = $_ -split '=', 2; Set-Item -Path "env:$($kv[0])" -Value $kv[1] }
#      （scripts/run.ps1 只透传白名单变量，不会把凭据写进命令行）
#   3. 也可以直接在命令里用 -Set @{ KEY='value' } 传入。
#
# 安全约束：本文件是模板，绝不允许出现真实密码/Token/AK/SK。

# ---- 必需（几乎每个场景都要）----
# 被测入口（k6 容器视角）。本地 kind：先 kubectl port-forward svc/surgecart 8000:8000
SURGECART_BASE_URL=http://host.docker.internal:8000
# 环境标识，进入结果元数据
TEST_ENV=local-kind
# 测试数据前缀：所有测试用户/商品/活动名都以此开头，便于识别与清理
DATA_PREFIX=k6t501

# ---- 需要写业务数据的场景才需要 ----
# 测试用户密码（IAM 规则 8~24 位）。首次运行会用它注册测试账号；
# 同一 RUN_ID 复跑必须保持同一密码，否则登录会失败（账号已存在但密码不同）。
K6_TEST_PASSWORD=
# 后台管理员账号（仅准备独立测试商品/SKU/秒杀活动时使用）。
# 建议使用项目 .env 中的超级管理员，仅在本会话注入，不要写入仓库。
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ---- 秒杀场景参数（由 tools/prepare-data.js 产出后回填）----
ACTIVITY_ID=
SKU_ID=
PRODUCT_ID=
FLASH_USERS=10
FLASH_TOTAL_STOCK=100
FLASH_IDEMPOTENCY_REPLAY=false
FLASH_VERIFY=false

# ---- 负载场景参数 ----
# low / medium / high（见 lib/stages.js），LOAD_VUS 可覆盖峰值 VU
LOAD_PROFILE=low
LOAD_VUS=
THINK_TIME_MS=200

# ---- 指标与监控 ----
# 被测进程当前生效的 dispatch_mode：kafka / db_scanner / unknown
# 影响 smoke 对 Kafka Lag、Outbox 指标族是否做强制断言
EXPECT_DISPATCH_MODE=kafka
# Prometheus 入口（用于人工/后续脚本关联查询，k6 本身不直接查询）
PROMETHEUS_BASE_URL=http://127.0.0.1:9090

# ---- 其它 ----
HTTP_TIMEOUT_MS=5000
K6_RAW_JSON=false
