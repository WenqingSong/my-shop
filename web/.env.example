# SurgeCart 用户商城前端 —— 环境变量模板
# 用法：cp .env.example .env.local 后按需修改；.env* 已被 .gitignore 忽略。
# 本文件只保存变量名与安全默认值，禁止写入任何真实密钥 / 账号 / 密码。

# API 基础路径。保持 /api：转发层剥离 /api 前缀后访问后端契约路径
# （本地由 vite.config.ts 的 proxy rewrite 完成；生产由反向代理/网关注入等价规则）。
# 保留独立前缀的原因：前端页面路由 /products 与后端 API /products 同名，
# 同源根路径直连会拦截 SPA 页面请求。
VITE_API_BASE_URL=/api

# 首页推荐位 code（对应 GET /recommendations/:code）。
# 后端没有公开的推荐位列表接口，code 由运营在后台创建；留空则不展示推荐区块。
VITE_HOME_RECOMMEND_CODE=

# 是否启用 MSW 浏览器 Mock。默认关闭，避免掩盖真实接口问题。
VITE_ENABLE_MOCK=false

# 请求超时（毫秒），不配置时使用 15000。
VITE_API_TIMEOUT_MS=15000

# 本地开发代理目标（仅 vite dev server 使用，指向本机后端统一入口）。
# 生产环境由 Nginx 反代，不读取该变量。
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8080
